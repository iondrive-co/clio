#!/usr/bin/env node
/*
 * A stand-in for Claude Code, for the agent tests.
 *
 * It does the three things the adapter reads: it writes a transcript into
 * $CLAUDE_CONFIG_DIR/projects/<slug>/<session id>.jsonl, it keeps a child
 * process carrying CLAUDE_CODE_SESSION_ID the way the real one's MCP servers do,
 * and it sits there in the foreground of the tab the way an agent does. It says
 * what it did on stdout, so the test can tell a conversation resumed from one
 * started fresh by reading the scrollback, which is what a person would be
 * doing too.
 *
 * `/clear` typed at it starts a new conversation in the same process, which is
 * the one case where the conversation in a tab changes without the process
 * changing with it.
 *
 * Started through a node shebang on purpose: that is how an npm-installed
 * claude appears in /proc — `node .../claude` rather than a program of its own
 * — so the adapter's match is being tested and not just a filename.
 */
import { mkdirSync, appendFileSync } from 'node:fs';
import { join } from 'node:path';
import { randomUUID } from 'node:crypto';
import { spawn } from 'node:child_process';

const argv = process.argv.slice(2);
const at = argv.indexOf('--resume');
const resuming = at !== -1 ? argv[at + 1] : null;

const dir = join(process.env.CLAUDE_CONFIG_DIR, 'projects', process.cwd().replace(/[^a-zA-Z0-9]/g, '-'));
mkdirSync(dir, { recursive: true });

/*
 * A child holding the id, which is what an MCP server is.
 *
 * The real one generates its session id after exec, so its own environment
 * cannot hold it — but everything it starts afterwards inherits one that does,
 * and that is how the adapter proves which conversation is in a tab instead of
 * guessing it from the newest file in a shared directory. So the stand-in keeps
 * one too, and starts it again whenever the conversation changes.
 *
 * It watches for its parent going and lets go when it does: a leftover process
 * holding the pty of a tab the test has finished with is how a sandbox stops
 * being one.
 */
let holder = null;
function hold(id) {
  holder?.kill();
  holder = spawn(
    process.execPath,
    ['-e', 'setInterval(() => { try { process.kill(Number(process.env.PARENT), 0); } catch { process.exit(0); } }, 200);'],
    {
      env: { ...process.env, CLAUDE_CODE_SESSION_ID: id, PARENT: String(process.pid) },
      stdio: 'ignore',
    },
  );
}

let sessionId = null;
function open(id, what) {
  sessionId = id;
  appendFileSync(
    join(dir, `${sessionId}.jsonl`),
    `${JSON.stringify({ type: 'turn', sessionId, timestamp: new Date().toISOString() })}\n`,
  );
  hold(sessionId);
  process.stdout.write(`${what} ${sessionId}\r\n`);
}

open(resuming || randomUUID(), resuming ? 'RESUMED' : 'STARTED');

/*
 * Titles, the way Claude Code writes them: a spinner into the terminal title
 * while it is working, and a still glyph the moment it stops. That is the only
 * place a terminal can see which of the two is going on — see `activity` in
 * src/agents/claude.js — so a stand-in that never writes one leaves the tab
 * flash with nothing to read.
 *
 * The work is deliberately longer than clio's two-second proc poll, so that a
 * poll cannot miss the spinner and mistake a turn for a tab that never worked.
 */
const SPINNER = ['◐', '◑'];
const FRAME_MS = 300;
const WORK_MS = 2400;

const announce = (glyph) => process.stdout.write(`\x1b]0;${glyph} a stand-in\x07`);
let spinning = null;

function stop() {
  clearInterval(spinning);
  spinning = null;
  announce('✳');
}
stop();

// Anything typed at it is a turn, except the one thing that is a change of
// conversation. Not raw mode, on purpose: Ctrl-C has to go on killing this the
// way it kills an agent, which is what test 5 is about.
process.stdin.on('data', (data) => {
  if (String(data).includes('/clear')) {
    open(randomUUID(), 'STARTED');
    return;
  }
  if (spinning) return;
  let frame = 0;
  spinning = setInterval(() => announce(SPINNER[frame++ % SPINNER.length]), FRAME_MS);
  setTimeout(stop, WORK_MS);
});

// Hold the terminal, as an agent waiting for you would.
setInterval(() => {}, 1 << 30);
