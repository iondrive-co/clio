#!/usr/bin/env bash
# clio — launcher. Starts the daemon if it is not already up, then opens a window.
set -euo pipefail

# Resolve symlinks before working out where clio lives. Without this, running
# via a link on PATH (~/.local/bin/clio) makes ROOT the link's parent, and the
# daemon entry point silently cannot be found.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
DAEMON_ENTRY="$ROOT/src/daemon/index.js"

if [ ! -f "$DAEMON_ENTRY" ]; then
  echo "clio: cannot find the daemon at $DAEMON_ENTRY" >&2
  echo "clio: resolved its own location to $ROOT — is the install intact?" >&2
  exit 1
fi
RUNTIME_DIR="${XDG_RUNTIME_DIR:-$HOME/.cache}/clio"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/clio"
HANDSHAKE="$RUNTIME_DIR/daemon.json"
LOG="$STATE_DIR/daemon.log"

mkdir -p "$RUNTIME_DIR" "$STATE_DIR"

field() { # field <key> — read a value out of the handshake file
  [ -f "$HANDSHAKE" ] || return 1
  node -e '
    const fs = require("fs");
    try {
      const info = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
      if (info[process.argv[2]] === undefined) process.exit(1);
      console.log(info[process.argv[2]]);
    } catch { process.exit(1); }
  ' "$HANDSHAKE" "$1"
}

daemon_pid() {
  local pid
  pid="$(field pid 2>/dev/null)" || return 1
  # A pid in the file proves nothing on its own; the process has to still exist.
  kill -0 "$pid" 2>/dev/null || return 1
  echo "$pid"
}

# Fetch dependencies on first run so a fresh clone needs no separate setup step.
ensure_deps() {
  if [ -d "$ROOT/node_modules/node-pty" ] && [ -d "$ROOT/node_modules/ws" ]; then
    return 0
  fi
  echo "clio: first run — installing dependencies (this happens once)…" >&2
  if ! (cd "$ROOT" && npm install --omit=dev --no-audit --no-fund >&2); then
    echo "clio: npm install failed. Run it yourself in $ROOT and try again." >&2
    return 1
  fi
}

start_daemon() {
  if daemon_pid >/dev/null; then return 0; fi

  ensure_deps || return 1
  rm -f "$HANDSHAKE"
  # setsid detaches the daemon from this shell's session, so closing the
  # terminal that launched clio cannot take the ptys down with it.
  setsid node "$DAEMON_ENTRY" >>"$LOG" 2>&1 < /dev/null &
  disown 2>/dev/null || true

  for _ in $(seq 1 100); do
    if daemon_pid >/dev/null; then return 0; fi
    sleep 0.05
  done

  echo >&2
  echo "clio: THE DAEMON DID NOT START. Your shells are gone until it does." >&2
  echo "clio: tried $DAEMON_ENTRY" >&2
  echo "clio: last lines of $LOG:" >&2
  tail -n 20 "$LOG" >&2 || true
  return 1
}

# Windows are put on screen by the daemon, not from here. The + at the end of
# the tab row asks for one too and cannot spawn a browser, so both go through
# the same path and a window opened either way is the same window.
#
# This brings back every set of tabs that has no window on it — that is how two
# windows left open before a reboot come back as two windows — and opens a new
# one only when there was nothing to restore. The display variables go with the
# request because the daemon may have been started from a session that has since
# gone away, leaving it pointing at a display that no longer exists.
open_windows() {
  node -e '
    const fs = require("fs");
    const file = process.argv[1];

    let info;
    try {
      info = JSON.parse(fs.readFileSync(file, "utf8"));
    } catch {
      console.error("clio: the daemon left no handshake file — is it running?");
      process.exit(1);
    }

    const env = {};
    for (const key of ["DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY",
                       "DBUS_SESSION_BUS_ADDRESS", "XDG_SESSION_TYPE"]) {
      if (process.env[key]) env[key] = process.env[key];
    }

    fetch(`http://127.0.0.1:${info.port}/windows?token=${info.token}`, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ cwd: process.cwd(), env }),
    })
      .then((res) => res.json())
      .then((out) => {
        for (const failure of out.failed || []) console.error(`clio: ${failure.error}`);
        if ((out.opened || []).length) return;
        if (out.url) {
          console.error("clio: open this address yourself to get the window:");
          console.error(out.url);
        }
        process.exit(1);
      })
      .catch((err) => {
        console.error(`clio: the daemon did not open a window (${err.message})`);
        process.exit(1);
      });
  ' "$HANDSHAKE"
}

# Swap the daemon for one running the code that is on disk now.
#
# The shells go across as open file descriptors, so nothing in a tab is
# restarted, reconnected or told anything happened — a build, an ssh session or
# an editor carries on through it. Windows blink as their socket drops and come
# back on their own.
#
# If the new code cannot start, the old daemon takes the shells back and stays
# up: a failed reload costs a couple of seconds, not a day's work.
reload_daemon() {
  local before="$1" now
  node -e '
    const fs = require("fs");
    const info = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    fetch(`http://127.0.0.1:${info.port}/reload?token=${info.token}`, { method: "POST" })
      .then((res) => {
        if (res.status === 202) return;
        if (res.status === 404) {
          console.error("clio: this daemon was started before reloading existed.");
          console.error("clio: it has to be stopped and started once — which does end its");
          console.error("clio: shells — and every reload after that keeps them.");
        } else {
          console.error(`clio: the daemon would not reload (${res.status})`);
        }
        process.exit(1);
      })
      .catch((err) => {
        console.error(`clio: could not ask for a reload (${err.message})`);
        process.exit(1);
      });
  ' "$HANDSHAKE" || return 1

  # The successor writes the handshake file only once it holds the shells, so a
  # new pid there is the whole proof that this worked.
  for _ in $(seq 1 200); do
    now="$(daemon_pid 2>/dev/null || true)"
    if [ -n "$now" ] && [ "$now" != "$before" ]; then
      echo "clio: reloaded — pid $before replaced by $now, shells untouched"
      return 0
    fi
    sleep 0.1
  done

  if kill -0 "$before" 2>/dev/null; then
    echo "clio: the new code did not start. The old daemon still has your shells." >&2
    echo "clio: see what went wrong with: $SELF log" >&2
  else
    echo "clio: the daemon is gone and nothing replaced it." >&2
    echo "clio: run $SELF to bring the windows back." >&2
  fi
  return 1
}

install_desktop() {
  local apps="$HOME/.local/share/applications"
  local icons="$HOME/.local/share/icons/hicolor"
  mkdir -p "$apps" "$HOME/.local/bin"

  # Crisp icons at every panel size. Chrome only ever publishes a 16x16 window
  # icon, so the panel needs its own copies to match the window by WM_CLASS.
  local installed=0
  for size in 256 128 48 32; do
    if [ -f "$ROOT/assets/icon-$size.png" ]; then
      mkdir -p "$icons/${size}x${size}/apps"
      cp "$ROOT/assets/icon-$size.png" "$icons/${size}x${size}/apps/clio.png"
      installed=$((installed + 1))
    fi
  done
  if [ -f "$ROOT/assets/icon.svg" ]; then
    mkdir -p "$icons/scalable/apps"
    cp "$ROOT/assets/icon.svg" "$icons/scalable/apps/clio.svg"
  fi

  cat > "$apps/clio.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=clio
GenericName=Terminal
Comment=The immortal terminal
Exec=$SELF
Icon=clio
Terminal=false
Categories=System;TerminalEmulator;
Keywords=terminal;shell;console;
StartupWMClass=clio
DESKTOP
  chmod +x "$apps/clio.desktop"

  ln -sf "$SELF" "$HOME/.local/bin/clio"

  command -v gtk-update-icon-cache >/dev/null 2>&1 && \
    gtk-update-icon-cache -f -t "$icons" >/dev/null 2>&1 || true
  command -v update-desktop-database >/dev/null 2>&1 && \
    update-desktop-database "$apps" >/dev/null 2>&1 || true

  echo "Installed:"
  echo "  $apps/clio.desktop"
  echo "  $installed icon size(s) into $icons"
  echo "  $HOME/.local/bin/clio -> $SELF"
  echo
  echo "clio is now in your applications menu, and the panel will show its icon."
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) echo "You can run it as: clio" ;;
    *) echo "Add ~/.local/bin to your PATH to run it as just: clio" ;;
  esac
}

case "${1:-run}" in
  run)
    start_daemon
    open_windows
    ;;

  install)
    install_desktop
    ;;

  start)
    start_daemon
    echo "clio daemon running (pid $(daemon_pid), $(field url | sed 's/?token=.*//'))"
    ;;

  stop)
    if pid="$(daemon_pid)"; then
      echo "Stopping clio daemon (pid $pid). Sessions are saved and can be restored."
      kill -TERM "$pid"
    else
      echo "clio daemon is not running."
    fi
    ;;

  reload)
    if pid="$(daemon_pid)"; then
      reload_daemon "$pid"
    else
      echo "clio daemon is not running — starting it."
      start_daemon
    fi
    ;;

  dev)
    # A whole second clio: its own daemon, port, token, state, browser profile
    # and windows, sharing nothing with the one running your real shells. New
    # code gets pointed at this until it is worth pointing at the other.
    #
    # Everything after `dev` is an ordinary clio command against that instance:
    # `clio dev`, `clio dev status`, `clio dev stop`, `clio dev log`.
    shift
    DEV_HOME="${CLIO_DEV_HOME:-${XDG_RUNTIME_DIR:-$HOME/.cache}/clio-dev}"
    mkdir -p "$DEV_HOME/run" "$DEV_HOME/state"
    export XDG_RUNTIME_DIR="$DEV_HOME/run"
    export XDG_STATE_HOME="$DEV_HOME/state"
    export CLIO_DEV=1
    exec "$SELF" "${@:-run}"
    ;;

  crash)
    # Deliberately ungraceful: SIGKILL gives the daemon no chance to save on the
    # way out, so this exercises the same path as a power cut, not a clean stop.
    if pid="$(daemon_pid)"; then
      echo "Killing clio daemon (pid $pid) with SIGKILL — no clean shutdown."
      kill -9 "$pid"
      sleep 1
      echo "Restarting…"
      start_daemon
      echo
      echo "Your open window should reconnect on its own within ~10 seconds and"
      echo "offer to restore each tab. If no window is open, run: $0"
    else
      echo "clio daemon is not running."
    fi
    ;;

  status)
    # Which clio this is, when there are two. Only the sandbox says so: the one
    # holding your real shells is the one that needs no explanation.
    if [ "${CLIO_DEV:-}" = "1" ]; then
      echo "instance: dev sandbox under $XDG_STATE_HOME"
    fi
    if pid="$(daemon_pid)"; then
      echo "daemon:   running (pid $pid)"
      echo "address:  $(field url | sed 's/?token=.*//')"
      # Asked of the daemon rather than read from the state file: the file is
      # written on a debounce and knows nothing about what is on screen.
      node -e '
        const fs = require("fs");
        const info = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
        fetch(`http://127.0.0.1:${info.port}/status?token=${info.token}`)
          .then((res) => res.json())
          .then((state) => {
            const shown = state.containers.filter((c) => c.onScreen).length;
            console.log(`windows:  ${state.containers.length} (${shown} on screen)`);
            state.containers.forEach((container, index) => {
              // A window with nothing on it is either one the daemon is about to
              // clear up after, or one left over from a daemon that went down.
              const note = container.onScreen
                ? ""
                : container.closing
                  ? "  — window closed, its shells are ending"
                  : "  — no window on it, run clio to bring it back";
              console.log(`  window ${index + 1}${note}`);
              for (const tab of container.sessions) {
                console.log(`    ${tab.id}  ${tab.title || tab.command || tab.cwd || "shell"}`);
              }
            });
          })
          .catch(() => console.log("windows:  (the daemon did not answer)"));
      ' "$HANDSHAKE"
    else
      echo "daemon:   not running"
      node -e '
        const fs = require("fs");
        try {
          const state = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
          const containers = state.containers?.length ? state.containers : [{ id: null }];
          console.log(`saved:    ${state.sessions.length} tab(s) in ${containers.length} window(s)`);
          containers.forEach((container, index) => {
            console.log(`  window ${index + 1}`);
            for (const tab of state.sessions) {
              if (container.id && tab.container !== container.id) continue;
              console.log(`    ${tab.id}  ${tab.title || tab.command || tab.cwd || "shell"}`);
            }
          });
        } catch {
          console.log("saved:    (no saved state yet)");
        }
      ' "$STATE_DIR/state.json"
      echo
      echo "Run 'clio' to bring it back: every saved window reopens with its tabs."
    fi
    ;;

  log)
    tail -n "${2:-50}" "$LOG"
    ;;

  *)
    cat <<'USAGE'
clio — the immortal terminal

  clio            reopen the windows a stopped daemon left, or start a new one
  clio install    add to the applications menu, panel icon and PATH
  clio start      start the daemon only
  clio reload     run the code that is on disk now, keeping every shell running
  clio dev [cmd]  a sandbox clio, sharing nothing with the shells you work in
  clio stop       stop the daemon (state is saved for restore)
  clio crash      SIGKILL the daemon and restart it, to test session restore
  clio status     show the daemon, its windows and their tabs
  clio log [n]    tail the daemon log
USAGE
    exit 1
    ;;
esac
